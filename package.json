    "clean": "hardhat clean",
    "node": "hardhat node --network hardhatMainnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.8.5",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
