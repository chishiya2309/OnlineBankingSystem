{
  "name": "online-banking-system",
  "version": "0.0.1",
  "private": true,
  "description": "Blockchain term deposits with immutable certificates, an interest vault and a React frontend",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "coverage": "hardhat test --coverage",
    "clean": "hardhat clean",
    "node": "hardhat node --network hardhatMainnet",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhatMainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:sepolia:force": "node scripts/force-deploy.mjs sepolia",
    "seed:local": "hardhat run scripts/seed.ts --network hardhatMainnet",
    "seed:sepolia": "hardhat run scripts/seed.ts --network sepolia",
    "verify-deploy:local": "hardhat run scripts/verify-deployment.ts --network hardhatMainnet",
    "verify-deploy:sepolia": "hardhat run scripts/verify-deployment.ts --network sepolia",
    "export-contracts": "hardhat run scripts/export-contracts.ts",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:localhost:force": "node scripts/force-deploy.mjs localhost",
    "seed:localhost": "hardhat run scripts/seed.ts --network localhost",
    "verify-deploy:localhost": "hardhat run scripts/verify-deployment.ts --network localhost",
    "time:advance": "hardhat run scripts/demo/advance-local-time.ts --network localhost",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "test:e2e": "hardhat compile && playwright test",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:report": "playwright show-report .e2e/report",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "demo:local": "hardhat compile && node scripts/e2e/local-stack.mjs",
    "demo:time": "node scripts/e2e/advance-time.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@playwright/test": "1.64.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.8.5",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
