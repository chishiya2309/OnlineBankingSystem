{
  "name": "online-banking-system",
  "version": "0.0.1",
  "private": true,
  "description": "Blockchain-based term deposit system - D1-02 development toolchain",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
